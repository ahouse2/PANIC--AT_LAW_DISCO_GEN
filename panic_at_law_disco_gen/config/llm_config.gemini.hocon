# AG2 LLM configuration — Google Gemini 2.5 Flash as primary

llms: {
  default: {
    provider: "google_genai"
    model: "gemini-2.5-flash"
    api_key_env: "GOOGLE_API_KEY"
    temperature: 0.2
    max_tokens: 8192
  }
  # Optional fallback — comment out to avoid usage
  gpt_fallback: {
    provider: "openai"
    model: "gpt-4.1-mini"
    api_key_env: "OPENAI_API_KEY"
    temperature: 0.2
  }
}

