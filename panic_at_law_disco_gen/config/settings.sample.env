# Dev defaults for panic_at_law_disco_gen (override as needed)
FLASK_SECRET_KEY=
JWT_SECRET=
DATABASE_URL=postgresql+psycopg2://postgres@postgres:5432/legal_discovery
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
QDRANT_HOST=qdrant
QDRANT_PORT=6333
AGENT_MANIFEST_FILE=/usr/src/app/registries/manifest.hocon
AGENT_LLM_INFO_FILE=/usr/src/app/registries/llm_config.hocon
AGENT_TOOL_PATH=/usr/src/app/coded_tools
UPLOAD_ROOT=/usr/src/app/uploads
INGESTION_WORKERS=4
INGESTION_MAX_PENDING=1000
